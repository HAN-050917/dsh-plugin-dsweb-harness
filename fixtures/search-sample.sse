data: {"p":"response/fragments/-1/results","v":[{"url":"https://tv.cctv.com/2026/10/14/VIDEBvJrpn4430p6YBXTDNkN261014.shtml","title":"[视频]李强出席第140届中国进出口商品交易会开幕式并发表主旨演讲","snippet":"[视频]李强出席第140届中国进出口商品交易会开幕式并发表主旨演讲 ... 国务院总理李强14日在广州出席第140届中国进出口商品交易会开幕式并发表主旨演讲。 李强表示，今年是广交会创办70周年。","cite_index":1,"published_at":1791907200.0,"site_icon":"https://cdn.deepseek.com/site-icons/cctv.com","site_name":"CCTV节目官网","query_indexes":[0],"provider":null},{"url":"https://tv.cctv.cn/2026/10/14/VIDELt351JSMRY7uEJqvyXg1261014.shtml","title":"[视频]国内联播快讯","snippet":"中央依法治国办启动领导干部依法办事情况法治督察 ... 2026年“社保服务进万家”活动今天启动 ... 我国将加强农村助老员队伍建设 ... 9月电商物流指数环比回升 供需协同向好","cite_index":2,"published_at":1791907200.0,"site_icon":"https://cdn.deepseek.com/site-icons/cctv.cn","site_name":"cctv.cn","query_indexes":[1],"provider":null},{"url":"https://www.fmprc.gov.cn/web/zyxw/202610/t20261014_12040263.shtml","title":"李强出席第140届中国进出口商品交易会开幕式并发表主旨演讲","snippet":"2026年10月14日下午，国务院总理李强在广州出席第140届中国进出口商品交易会（广交会）开幕式并发表主旨演讲。","cite_index":3,"published_at":1791907200.0,"site_icon":"https://cdn.deepseek.com/site-icons/fmprc.gov.cn","site_name":"中华人民共和国外交部","query_indexes":[0],"provider":null},{"url":"https://news.cctv.com/2026/10/14/ARTIGJ3H1mcIZJEh25jvZvzZ261014.shtml","title":"【8点见】患者送1.9元汽水后举报医院工作人员收礼，官方回应","snippet":"【8点见】患者送1.9元汽水后举报医院工作人员收礼 ... 央视网 | 2026年10月14日 08:01:36 ... ·患者送1.9元汽水后举报医院药房工作人员违规收礼，佛山市卫生健康局 ... ·四川宜宾一炸串女摊主被差评后跳河轻生...","cite_index":4,"published_at":1791907200.0,"site_icon":"https://cdn.deepseek.com/site-icons/cctv.com","site_name":"央视网","query_indexes":[1],"provider":null},{"url":"https://tv.cctv.cn/2026/10/14/VIDEEQCJJkfShTNYf1Zl2Zgj261014.shtml","title":"[天下财经]第140届广交会开幕在即 广州口岸迎来广交会客货入境高峰","snippet":"[天下财经]第140届广交会开幕在即 广州口岸迎来广交会客货入境高峰 来源 : 央视网 2026-10-14 12:33 内容简介 21+1 关注 ... 第140届广交会开幕在即：广州口岸迎来广交会客货入境高峰。","cite_index":5,"published_at":1791907200.0,"site_icon":"https://cdn.deepseek.com/site-icons/cctv.cn","site_name":"cctv.cn","query_indexes":[0],"provider":null},{"url":"http://big5.cctv.com/gate/big5/news.cctv.cn/2026/10/14/ARTIGJ3H1mcIZJEh25jvZvzZ261014.shtml","title":"【8點見】患者送1.9元汽水後舉報醫院工作人員收禮，官方回應","snippet":"【8點見】患者送1.9元汽水後舉報醫院工作人員收禮，官方回應 來源：央視網 | 2026年10月14日 08:01:36 ... ·患者送1.9元汽水後舉報醫院藥房工作人員違規收禮，佛山市衞生健康局...","cite_index":6,"published_at":1791907200.0,"site_icon":"https://cdn.deepseek.com/site-icons/cctv.com","site_name":"央视网","query_indexes":[1],"provider":null},{"url":"https://tv.cctv.com/2026/10/14/VIDEOJsqYdUSC2c5SzlX8FlD261014.shtml","title":"《第一时间》 20261014 2/2","snippet":"第140届广交会开幕在即：广州口岸迎来广交会客货入境高峰；2026年前八月我国服务贸易出口同比增14.8%；江苏 ... 2026年10月14日 09 ... - 视频简介 本期节目主要内容...","cite_index":7,"published_at":1791907200.0,"site_icon":"https://cdn.deepseek.com/site-icons/cctv.com","site_name":"CCTV节目官网","query_indexes":[0],"provider":null},{"url":"https://tv.cctv.cn/2026/10/14/VIDEnQPRqQwcOFHIj9y4Ydny261014.shtml","title":"《新闻直播间》 20261014 17:00","snippet":"国家统计局：前三季度居民消费价格指数同比涨0.9%；中方近期举办一系列展会·外交部：连接全球，赋能发展的重要窗口；国务院台办：充分肯定台湾艺人国庆之际为祖国献祝福。 （《新闻直播间》 20261014 17...","cite_index":8,"published_at":1791907200.0,"site_icon":"https://cdn.deepseek.com/site-icons/cctv.cn","site_name":"cctv.cn","query_indexes":[1],"provider":null},{"url":"https://am.china-embassy.gov.cn/chn/zgxw/202610/t20261014_12040173.htm","title":"习近平向第140届中国进出口商品交易会致贺信_中华人民共和国驻亚美尼亚共和国大使馆","snippet":"2026年10月14日，国家主席习近平向第140届中国进出口商品交易会（广交会）致贺信 ... 第140届广交会当日在广东省广州市开幕，由商务部和广东省人民政府共同主办。","cite_index":9,"published_at":1791907200.0,"site_icon":"https://cdn.deepseek.com/site-icons/china-embassy.gov.cn","site_name":"驻亚美尼亚大使馆","query_indexes":[0],"provider":null},{"url":"https://www.163.com/dy/article/L978PVNN05346RC6.html","title":"新华社快讯：习近平向第140届中国进出口商品交易会致贺信","snippet":"习近平向第140届中国进出口商品交易会致贺信 2026-10-14 15:18:23 来源 ... 10月14日，国家主席习近平向第140届中国进出口商品交易会（广交会）致贺信。","cite_index":10,"published_at":1791907200.0,"site_icon":"https://cdn.deepseek.com/site-icons/163.com","site_name":"网易","query_indexes":[1],"provider":null},{"url":"https://www.toutiao.com/article/7696499784085013026/?wid=1791981698938","title":"10月14日新闻夜览","snippet":"2026年10月14日，“羲和号”升空5年后，南京大学、中国航天科技集团上海航天技术研究院、中国科学院长春光机所等三家研制单位向记者介绍了我国太阳探测的进展成果与后续规划。","cite_index":11,"published_at":1791907200.0,"site_icon":"https://cdn.deepseek.com/site-icons/toutiao.com","site_name":"今日头条","query_indexes":[1],"provider":null},{"url":"https://jp.news.cn/20261014/7822bff7f151450992a827f796c5a8f7/c.html","title":"李強総理、「広交世界７０周年」座談会に出席","snippet":"【新華社広州１０月１４日】中国の李強（り・きょう）国務院総理は１４日、広東省広州市で開かれた中国輸出入商品交易会（広州交易会）７０周年を記念する「広交世界７０周年」座談会に出席した。","cite_index":12,"published_at":1791907200.0,"site_icon":"https://cdn.deepseek.com/site-icons/news.cn","site_name":"新華網日本語","query_indexes":[0],"provider":null}]}

